{
  "info": {
    "name": "MERN Auth & User Management API",
    "_postman_id": "7f7f7f7f-1111-4444-8888-222222222222",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Ajinkya\",\"email\":\"ajinkya@example.com\",\"password\":\"StrongPassword123\"}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"ajinkya@example.com\",\"password\":\"StrongPassword123\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Current User",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "Update Profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Ajinkya Developer\"}"
        },
        "url": "{{baseUrl}}/api/users/profile"
      }
    },
    {
      "name": "Change Password",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"currentPassword\":\"StrongPassword123\",\"newPassword\":\"NewStrongPassword123\"}"
        },
        "url": "{{baseUrl}}/api/users/change-password"
      }
    },
    {
      "name": "Admin - List Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users?page=1&limit=10&search="
      }
    }
  ]
}